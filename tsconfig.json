{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "removeComments": true,
    "strict": true,
    "skipLibCheck": true,
    "importHelpers": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "exclude": ["website", "build/*.ts"]
}
